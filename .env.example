# Live profile: a real model backend. Never commit a real API key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=REPLACE_WITH_AVAILABLE_MODEL_ID
LLM_API_KEY=REPLACE_WITH_YOUR_KEY
LLM_TIMEOUT_SECONDS=60

# Total time budget for one model call (seconds).
MODEL_DEADLINE_SECONDS=30

# In-memory cache: lifetime of an answer (seconds) and maximum number of answers.
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=100

# One JSON line per request; relative paths start at this folder.
REQUEST_LOG_FILE=logs/requests.jsonl
